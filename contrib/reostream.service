[Unit]
Description=reostream Reolink Baichuan to MPEG-TS bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=reostream
Group=reostream

# EnvironmentFile holds camera passwords, not the unit itself. Create it
# with mode 0600 owned by root (or by the reostream user), e.g.:
#   /etc/reostream/reostream.env containing REOSTREAM_DRIVEWAY_PASSWORD=...
EnvironmentFile=/etc/reostream/reostream.env

# -data, not -config. An explicit -config naming a file that does not exist
# is deliberately fatal, so a fresh install with that flag would exit 1 and
# never reach the claim screen; -data names a DIRECTORY, and reostream
# writes <data>/config.toml itself when the install is claimed. StateDirectory
# below is what makes that directory exist and be writable by this unit's
# user even under ProtectSystem=strict; systemd creates /var/lib/reostream
# owned by reostream:reostream before ExecStart runs.
ExecStart=/usr/local/bin/reostream -data /var/lib/reostream

# /var/lib/reostream, created and chowned by systemd. It holds config.toml,
# which holds camera passwords and the control password, so it is not
# world-readable.
StateDirectory=reostream
StateDirectoryMode=0700

# KillSignal and TimeoutStopSec are deliberate, not defaults left in place.
# On a stop, the daemon sends a stream-stop message to every connected
# camera before exiting, which is what releases that camera's session; a
# camera whose session is not released refuses new connections for several
# minutes. That only happens on a clean SIGTERM, and the daemon can take up
# to 5 seconds (runStopGrace) plus its own HTTP shutdown window to finish
# it. SIGKILL skips all of that, so KillSignal must stay SIGTERM and
# TimeoutStopSec must stay comfortably above 5 seconds. Do not shorten
# either to make a restart feel snappier.
KillSignal=SIGTERM
TimeoutStopSec=30

Restart=on-failure
RestartSec=5

# Hardening. Each of these was chosen for a service that only opens an
# outbound TCP connection to cameras and an inbound HTTP listener, reads its
# env file from /etc, and writes its config under StateDirectory; nothing
# here needs write access to the rest of the filesystem, a home directory,
# or elevated privileges. ProtectSystem=strict leaves StateDirectory
# writable, which is the one path that has to be.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
